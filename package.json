{
  "name": "opencanvas",
  "version": "0.2.0",
  "description": "An infinite canvas that your local LLM draws typed widgets on. BYO model (Claude / OpenAI / OpenRouter / Ollama / Amp), MCP-native, self-improving knowledge base, single-user, runs entirely on your machine.",
  "author": {
    "name": "Krunal Ashar",
    "email": "krunal.ashar@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://ashark-ai-05.github.io/opencanvas/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashark-ai-05/opencanvas.git"
  },
  "bugs": {
    "url": "https://github.com/ashark-ai-05/opencanvas/issues"
  },
  "keywords": [
    "infinite-canvas",
    "tldraw",
    "llm",
    "agent",
    "anthropic",
    "claude",
    "openai",
    "ollama",
    "mcp",
    "model-context-protocol",
    "knowledge-base",
    "rag",
    "local-first",
    "electron",
    "byo-model"
  ],
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/start.mjs",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit -p app",
    "backend": "bash scripts/backend.sh",
    "backend:check": "bash scripts/backend.sh --smoke",
    "dev": "concurrently --names 'backend,app' --kill-others --kill-others-on-fail 'pnpm backend' 'pnpm app'",
    "preapp": "node scripts/copy-vendor-libs.mjs",
    "app": "vite --config app/vite.config.ts",
    "preapp:build": "node scripts/copy-vendor-libs.mjs",
    "app:build": "vite build --config app/vite.config.ts",
    "app:preview": "vite preview --config app/vite.config.ts",
    "electron": "electron .",
    "electron:dev": "concurrently --names 'dev,electron' --kill-others --kill-others-on-fail 'pnpm dev' 'electron --no-sandbox .'",
    "electron:rebuild": "electron-builder install-app-deps",
    "dist": "pnpm app:build && pnpm backend:build && electron-builder",
    "dist:mac": "pnpm app:build && pnpm backend:build && electron-builder --mac",
    "dist:win": "pnpm app:build && pnpm backend:build && electron-builder --win",
    "dist:linux": "pnpm app:build && pnpm backend:build && electron-builder --linux",
    "icons:build": "node scripts/build-icons.mjs",
    "icons:og": "node scripts/build-og-image.mjs",
    "backend:build": "node scripts/build-backend.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.84",
    "@ai-sdk/google": "^4.0.101",
    "@ai-sdk/groq": "^4.0.66",
    "@ai-sdk/openai": "^4.0.98",
    "@ai-sdk/react": "^4.0.151",
    "@anthropic-ai/claude-agent-sdk": "^0.3.304",
    "@anthropic-ai/sdk": "^0.95.2",
    "@hono/node-server": "^2.1.5",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@sourcegraph/amp-sdk": "0.1.0-20260729105907-g72d5ca3",
    "ai": "^7.0.147",
    "better-sqlite3": "^13.0.3",
    "chrono-node": "^2.10.3",
    "cron-parser": "^5.10.2",
    "framer-motion": "^14.4.0",
    "hono": "^4.13.13",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.2.0",
    "ollama": "^0.6.4",
    "ollama-ai-provider-v2": "^4.0.1",
    "onnxruntime-node": "^1.30.0",
    "openai": "^7.39.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "sqlite-vec": "^0.1.9",
    "tldraw": "^3.15.6",
    "tree-sitter-typescript": "^0.23.2",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "web-tree-sitter": "^0.26.13",
    "xlsx": "npm:@e965/xlsx@^0.20.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "electron": "^42.11.17",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "^25.0.1",
    "playwright": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.opencanvas.app",
    "productName": "OpenCanvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "app/dist/**/*",
      "dist-backend/**/*",
      "package.json",
      "!{src,docs,__tests__,spikes,scripts,examples,launcher,build,release,.github,.remember}/**",
      "!*.{md,toml,yaml,yml,ts,lock}",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk*/**",
      "!**/node_modules/@ampcode/**",
      "!**/node_modules/@sourcegraph/**",
      "!**/node_modules/{tldraw,@tldraw,vega,vega-lite,vega-embed,mermaid,react,react-dom,react-markdown,remark-gfm,sonner,lucide-react,framer-motion,zustand,@ai-sdk/react}/**",
      "!**/node_modules/onnxruntime-web/dist/*.wasm",
      "!**/node_modules/@huggingface/transformers/.cache/**",
      "!**/node_modules/**/*.{md,map,ts,d.ts}",
      "!**/node_modules/**/{test,tests,__tests__,docs,example,examples}/**"
    ],
    "asarUnpack": [
      "**/node_modules/{better-sqlite3,onnxruntime-node,sqlite-vec,web-tree-sitter,tree-sitter-typescript,sharp,@img}/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v*/{linux,win32}/**"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v*/{darwin,linux}/**"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v*/{darwin,win32}/**"
      ]
    }
  }
}
