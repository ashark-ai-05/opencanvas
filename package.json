{
  "name": "opencanvas",
  "version": "0.1.0",
  "description": "An infinite canvas that your local LLM draws typed widgets on. BYO model (Claude / OpenAI / OpenRouter / Ollama / Amp), MCP-native, self-improving knowledge base, single-user, runs entirely on your machine.",
  "author": {
    "name": "Krunal Ashar",
    "email": "krunal.ashar@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://ashark-ai-05.github.io/opencanvas/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashark-ai-05/opencanvas.git"
  },
  "bugs": {
    "url": "https://github.com/ashark-ai-05/opencanvas/issues"
  },
  "keywords": [
    "infinite-canvas",
    "tldraw",
    "llm",
    "agent",
    "anthropic",
    "claude",
    "openai",
    "ollama",
    "mcp",
    "model-context-protocol",
    "knowledge-base",
    "rag",
    "local-first",
    "electron",
    "byo-model"
  ],
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "backend": "bash scripts/backend.sh",
    "backend:check": "bash scripts/backend.sh --smoke",
    "dev": "concurrently --names 'backend,app' --kill-others --kill-others-on-fail 'pnpm backend' 'pnpm app'",
    "preapp": "node scripts/copy-vendor-libs.mjs",
    "app": "vite --config app/vite.config.ts",
    "preapp:build": "node scripts/copy-vendor-libs.mjs",
    "app:build": "vite build --config app/vite.config.ts",
    "app:preview": "vite preview --config app/vite.config.ts",
    "electron": "electron .",
    "electron:dev": "concurrently --names 'dev,electron' --kill-others --kill-others-on-fail 'pnpm dev' 'electron --no-sandbox .'",
    "electron:rebuild": "electron-builder install-app-deps",
    "dist": "pnpm app:build && electron-builder",
    "dist:mac": "pnpm app:build && electron-builder --mac",
    "dist:win": "pnpm app:build && electron-builder --win",
    "dist:linux": "pnpm app:build && electron-builder --linux",
    "icons:build": "node scripts/build-icons.mjs",
    "icons:og": "node scripts/build-og-image.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.79",
    "@ai-sdk/google": "^3.0.79",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/openai": "^3.0.65",
    "@ai-sdk/react": "^3.0.193",
    "@anthropic-ai/claude-agent-sdk": "^0.3.150",
    "@anthropic-ai/sdk": "*",
    "@hono/node-server": "^2.1.1",
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@sourcegraph/amp-sdk": "0.1.0-20260729105907-g72d5ca3",
    "ai": "^6.0.191",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.5.0",
    "framer-motion": "^12.40.0",
    "hono": "^4.13.9",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.12.3",
    "mermaid": "^11.17.2",
    "ollama": "*",
    "ollama-ai-provider-v2": "^3.5.1",
    "onnxruntime-node": "^1.30.0",
    "openai": "*",
    "pdf-parse": "^2.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7",
    "sqlite-vec": "^0.1.6",
    "tldraw": "^3.0.0",
    "tree-sitter-typescript": "^0.23.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "web-tree-sitter": "^0.26.9",
    "xlsx": "npm:@e965/xlsx@^0.20.3",
    "yaml": "^2.9.0",
    "zod": "*",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "*",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "*",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "electron": "^42.2.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.60.0",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.3.0",
    "tsx": "*",
    "typescript": "*",
    "vite": "^6.0.0",
    "vitest": "*"
  },
  "build": {
    "appId": "com.opencanvas.app",
    "productName": "OpenCanvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "app/dist/**/*",
      "dist-backend/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/{better-sqlite3,onnxruntime-node,sqlite-vec,web-tree-sitter,tree-sitter-typescript}/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    }
  }
}
